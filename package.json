{
  "name": "medlyn",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "smoke": "pnpm --filter @medlyn/engine smoke",
    "db:push": "pnpm --filter @medlyn/engine db:push",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "ingest": "pnpm --filter @medlyn/engine ingest",
    "lens": "pnpm --filter @medlyn/engine lens",
    "dev": "pnpm --filter @medlyn/web dev",
    "eval": "pnpm --filter @medlyn/eval eval",
    "warm": "pnpm --filter @medlyn/engine warm"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  }
}
