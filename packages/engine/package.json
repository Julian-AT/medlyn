{
  "name": "@medlyn/engine",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./*.ts"
  },
  "scripts": {
    "smoke": "node --env-file=../../.env --experimental-strip-types llm/smoke.ts",
    "ingest": "node --env-file=../../.env --experimental-strip-types --no-warnings ingest/run.ts",
    "lens": "node --env-file=../../.env --experimental-strip-types --no-warnings lens/cli.ts",
    "db:push": "drizzle-kit push",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "warm": "node --env-file=../../.env --experimental-strip-types --no-warnings lens/warm.ts",
    "lint": "biome check ."
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "ai": "^7.0.157",
    "drizzle-orm": "^0.44.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@medlyn/tsconfig": "workspace:*",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.0",
    "vitest": "^3.2.0"
  }
}
