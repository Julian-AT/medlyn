# CLIProxyAPI (OpenAI-compatible). List models with: curl -H "Authorization: Bearer $OPENAI_API_KEY" $OPENAI_BASE_URL/models
OPENAI_BASE_URL=http://localhost:8317/v1
OPENAI_API_KEY=
# Deployment helper maps this separate direct OpenAI key to OPENAI_API_KEY on Vercel.
OPENAI_API_KEY_PROD=

# Model roles; `pnpm smoke` reports capability and latency per model
MODEL_REASONING=
MODEL_FAST=
# Optional production role overrides; otherwise deploy the roles above.
MODEL_REASONING_PROD=
MODEL_FAST_PROD=
MODEL_STT=

# Gemini Embedding 2 API for text and page/image retrieval
GEMINI_API_KEY=

# Optional semantic verifier backend: unset uses GPT; local requires a verified trained model
MEDLYN_VERIFIER=

# Neon Postgres
DATABASE_URL=
DATABASE_URL_DEMO=

# fish.audio text-to-speech
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=

# Local challenge data, never committed
MEDLYN_DATA_PATH=./TRACK-1-clinical-documentation/data/patient-0000-0001

# Required password and independent signing secret for hosted app access.
DEMO_PASSWORD=
# At least 32 characters; generate once with: openssl rand -hex 32
DEMO_SESSION_SECRET=

# Max concurrent proxy requests per process (default 8; use 3 for synthetic jobs)
MEDLYN_LLM_CONCURRENCY=

# Gemini Embedding 2 pacing per process (free tier: 100 inputs/min)
GEMINI_EMBED_REQUESTS_PER_MINUTE=80

# Public landing-page origin and the separate patient-app origin (set before building)
NEXT_PUBLIC_SITE_URL=https://medlyn.health
NEXT_PUBLIC_APP_URL=https://app.medlyn.health

# IBM Quantum Platform API key (quantum research experiment)
IBM_QUANTUM_TOKEN=
